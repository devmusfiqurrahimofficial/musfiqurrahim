# ==========================================
# 1. DATABASE (Required on Vercel)
# ==========================================
# Your MongoDB connection string (e.g., MongoDB Atlas SRV URI)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/portfolio?retryWrites=true&w=majority
MONGODB_DB=portfolio

# ==========================================
# 2. FIREBASE ADMIN / BACKEND AUTH (Required on Vercel)
# ==========================================
# Firebase Project ID (e.g. portfolio-c26b1)
FIREBASE_PROJECT_ID=portfolio-c26b1

# Comma-separated list of admin email addresses allowed to manage the site
ADMIN_EMAILS=devmusfiqurrahimofficial@gmail.com

# Optional: Comma-separated list of admin Firebase UIDs
ADMIN_UIDS=

# Optional: Firebase Service Account credentials for server-side verification
# Either provide client email + private key or full JSON string
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Or full service account JSON:
# FIREBASE_SERVICE_ACCOUNT=

# ==========================================
# 3. FIREBASE CLIENT / FRONTEND (Required on Vercel)
# ==========================================
# These are baked into the frontend bundle at build time for the admin login
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=portfolio-c26b1
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# Optional: Next.js API URL
# Leave empty on Vercel to automatically use same-origin /api
NEXT_PUBLIC_API_URL=

# Legacy VITE_ aliases also supported for backwards compatibility:
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_APP_ID=

# ==========================================
# 4. EMAIL FORWARDING (Optional)
# ==========================================
# Nodemailer SMTP configuration for /api/mail (forwarding messages to owner email)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
