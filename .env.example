# Firebase web app config for the admin panel's sign-in. Copy to .env and fill in from
# Firebase console → Project settings → Your apps. Vite exposes only VITE_* variables, and
# they end up in the built JavaScript: this config identifies the project, it isn't a secret.
# Who may edit the site is decided by the server (ADMIN_EMAILS / ADMIN_UIDS in server/.env).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_APP_ID=
