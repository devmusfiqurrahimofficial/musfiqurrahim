# Copy to .env and fill in. Never commit .env.
PORT=4000

# Firebase project whose ID tokens the API accepts (the same project as VITE_FIREBASE_* in ../client/.env).
FIREBASE_PROJECT_ID=portfolio-c26b1

# Who may use the admin panel. Comma-separated. An email only counts once Firebase has
# verified it (Google sign-in always is). ADMIN_UIDS is the stricter option: copy your uid
# from the admin's Account page or the Firebase console.
ADMIN_EMAILS=you@example.com
# ADMIN_UIDS=

# SMTP settings for sending email from the admin Mail page.
# To send real mail, set these (e.g. Gmail: host=smtp.gmail.com, port=587, user=your@gmail.com, pass=app-password).
# If not configured, the Mail page will return a 500 error.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your@gmail.com
# SMTP_PASS=your-app-password

# Comma-separated origins allowed to call the API from another domain.
# Not needed in dev (Vite proxies /api) or when this server also serves dist/.
CORS_ORIGIN=http://localhost:5173

# MongoDB connection string. Local default shown; for Atlas use the mongodb+srv:// URI it gives you.
# A quick local server: podman run -d --name portfolio-mongo -p 27017:27017 -v portfolio-mongo:/data/db docker.io/library/mongo:7.0
MONGODB_URI=mongodb://127.0.0.1:27017/portfolio
# Database name, if the URI doesn't include one (defaults to "portfolio").
# MONGODB_DB=portfolio

# Set when running behind a reverse proxy (e.g. 1) so the contact-form rate limit sees real visitor IPs.
# TRUST_PROXY=1
